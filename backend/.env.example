# CyberUndo Environment Configuration
PORT=5000
SECRET_KEY=change-this-in-production-super-secret-key
JWT_SECRET_KEY=change-this-in-production-jwt-key
DATABASE_URL=sqlite:///cyberundo.db
UPLOAD_FOLDER=uploads

# Transactional Email REST API (Brevo - Preferred / Resend - Fallback)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM=CyberUndo Security <your_verified_sender@gmail.com>
FRONTEND_URL=https://cyber-undo.vercel.app
RESEND_API_KEY=re_your_resend_api_key_here
