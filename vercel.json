{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/share/:id*",
      "destination": "/share"
    },
    {
      "source": "/share",
      "destination": "/share"
    },
    {
      "source": "/frontend/share/:id*",
      "destination": "/frontend/share"
    },
    {
      "source": "/frontend/share",
      "destination": "/frontend/share"
    }
  ]
}
